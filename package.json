{
  "name": "atlas-watch",
  "productName": "Atlas Watch",
  "version": "0.4.4",
  "description": "See what is happening around the places you care about.",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "author": "Atlas Watch",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "cesium": "^1.147.0",
    "geographiclib-geodesic": "^2.2.0",
    "hls.js": "^1.6.15",
    "papaparse": "^5.7.0",
    "pbf": "^5.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satellite.js": "^6.0.2",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "dist": "npm run build && npm run notices && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && npm run notices && electron-builder --win dir --x64"
  }
}
